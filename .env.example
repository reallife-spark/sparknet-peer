# Vault configuration for the peer-node subvault.
#
# The wiki skill suite resolves config by walking up from the CWD and stopping
# at the first .env that sets VAULT_PATH. This file exists so that a session
# started inside peer-node/ targets THIS subvault rather than the parent.
#
# Do not hand-copy this file. Run `make env-init` (or
# `../scripts/sparknet-env-init.sh <this dir>`), which substitutes the absolute
# paths below for wherever the repository is checked out and then verifies that
# the wiki skills resolve to THIS vault. Copying by hand is how a role ends up
# with a `.env` pointing at another vault.
VAULT_PATH="/absolute/path/to/sparknet/peer-node"
VAULT_CATEGORIES="concepts,entities,skills,references,synthesis,journal"
VAULT_SOURCES_DIR="/absolute/path/to/sparknet/peer-node/_raw"
VAULT_LINK_FORMAT="wikilink"
WIKI_TOKEN_WARN_THRESHOLD="100000"
WIKI_STAGED_WRITES="false"