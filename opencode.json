{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CONTEXT.md",
    "AGENTS.md",
    "MISSION.md",
    "INTENT.md",
    "00_System/alpha-agent.md"
  ],
  "skills": {
    "paths": ["../.opencode/skills"]
  },
  "references": {
    "knowledge": {
      "path": ".",
      "description": "The peer-node knowledge vault. Use for this role's scope, design intent, operating rules, plans and decisions."
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "wiki-ingest": "allow",
      "wiki-query": "allow",
      "wiki-capture": "allow",
      "wiki-lint": "allow",
      "wiki-status": "allow",
      "wiki-update": "allow",
      "wiki-digest": "allow",
      "wiki-dedup": "allow",
      "wiki-synthesize": "allow",
      "wiki-research": "allow",
      "wiki-context-pack": "allow",
      "wiki-export": "allow",
      "cross-linker": "allow",
      "tag-taxonomy": "allow",
      "llm-wiki": "allow",
      "domain-modeling": "allow",
      "code-review": "allow",
      "tdd": "allow",
      "diagnosing-bugs": "allow",
      "implement": "allow",
      "implement-spec": "allow",
      "pr": "allow",
      "triage": "allow",
      "research": "allow",
      "understand": "allow",
      "brainstorming": "allow",
      "writing-plans": "allow",
      "executing-plans": "allow",
      "systematic-debugging": "allow",
      "verification-before-completion": "allow",
      "python-testing-patterns": "allow",
      "spark-environment-setup": "allow",
      "spark-memory-thermal-ops": "allow",
      "vllm": "allow",
      "secure-code-guardian": "allow"
    },
    "edit": {
      "*": "allow",
      "../master-node/**": "deny",
      "../master-node/.state/**": "deny",
      ".state/keys/**": "deny",
      "../contracts/**": "deny",
      "../shared/**": "deny"
    },
    "bash": {
      "*": "allow",
      "*master-node/.state/keys*": "deny",
      "*signer.sock*": "deny"
    }
  },
  "mcp": {
    "sparknet-skills": {
      "type": "local",
      "command": [
        "python3",
        "../shared/sparknet-skills-mcp.py",
        "--catalog",
        "../.opencode/skills/.catalog.json",
        "--catalog",
        ".opencode/skills/.catalog.json"
      ],
      "enabled": true
    },
    "sparknet-memory": {
      "type": "local",
      "command": [
        "python3",
        "../shared/sparknet-memory-mcp.py",
        "--vault",
        "."
      ],
      "enabled": true
    }
  }
}
