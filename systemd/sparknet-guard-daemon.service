[Unit]
Description=Sparknet Critical File Guard (Master-gated immutable file guard)
# The guard refuses to bind unless the overlay is up (see the runtime anchored
# check in sparknet-guard-d.py). That refusal is the real gate, so this unit does
# NOT hard-Require the wg-quick anchor: a deployment that brings the overlay up
# out-of-band (e.g. userspace wireguard-go wg1, where wg-quick + kernel module is
# unavailable) must not have the guard drag in an anchor it cannot run. After=
# network-online is enough; the guard declines to listen until it is anchored.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
StateDirectory=sparknet
StateDirectoryMode=0700
# No WorkingDirectory and no vault path: the generated shim resolves the vault.
# --apply-enabled is deliberately absent, so the daemon starts in verify-and-audit
# mode. Arming is an explicit operator decision, because applying means lifting
# chattr +i on root-owned /etc files. Only one ExecStart is valid for Type=simple.
ExecStart=/usr/local/libexec/sparknet/sparknet-guard
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target