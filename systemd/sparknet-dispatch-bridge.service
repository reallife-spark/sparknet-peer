[Unit]
Description=Sparknet dispatch bridge (signed /v1/status plus OpenAI/admin surfaces)
Documentation=file:///usr/local/libexec/sparknet/sparknet-dispatch-bridge
# The bridge offers two personalities: a loopback-only OpenAI/session/vault
# surface that injects the local user environment, and an overlay-reachable
# signed /v1/status + /admin/* surface the Master federates over. It therefore
# listens on BOTH loopback and the node's overlay address and never a wildcard —
# see contracts/admin-federation-runbook.md (Finding F1). Binding 0.0.0.0 would
# expose the environment injector to the LAN, which is worse than the overlay.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raxxar
# Reflex is local-first: `local` uses the on-node reranker/LLM and never
# egresses. Broker mode is opt-in and points at the Master's 4224 endpoint;
# `/v1/reflex/*` stays loopback-only regardless.
EnvironmentFile=-%h/.env
Environment=SPARKNET_REFLEX_MODE=local
Environment=SPARKNET_REFLEX_BACKEND=local
Environment=SPARKNET_REFLEX_ALLOW_EGRESS=0
Environment=SPARKNET_REFLEX_LOCAL_URL=http://127.0.0.1:8000
Environment=SPARKNET_REFLEX_LOCAL_MODEL=local
Environment=SPARKNET_REFLEX_BROKER_URL=http://10.100.0.1:4224
Environment=SPARKNET_REFLEX_TIMEOUT=2.0
# No WorkingDirectory: the generated shim resolves the vault. --bind is
# repeatable (one listener per address); the overlay address is this node's
# authorized 10.100.0.2/32 from manifests/node-identity.json.
ExecStart=/usr/local/libexec/sparknet/sparknet-dispatch-bridge --serve --bind 127.0.0.1 --bind 10.100.0.2
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
