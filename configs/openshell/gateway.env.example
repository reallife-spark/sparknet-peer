# OpenShell gateway environment for the sparknet peer.
#
# The install renderer (`scripts/sparknet-openshell-config.py`) writes the real
# file at ~/.config/openshell/gateway.env from manifests/openshell.json. These
# values are digest-pinned image overrides; do not use mutable tags.
#
# OPENSHELL_SANDBOX_RUNTIME_IMAGE=ghcr.io/nvidia/openshell/sandbox@sha256:...
# OPENSHELL_SUPERVISOR_IMAGE=ghcr.io/nvidia/openshell/supervisor@sha256:...
#
# Only override the package-managed local TLS directory if the package layout
# actually changed. The default discovery is the safe one.
# OPENSHELL_LOCAL_TLS_DIR=
